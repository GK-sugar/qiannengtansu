# ============================================================
# 黔能碳溯 · docker compose 环境变量模板
# 用法： 复制为 .env 后执行  docker compose --env-file .env up -d --build
# 所有【此处需填入API Key】项留空也能启动（自动降级演示模式）
# ============================================================

# ---------- 运行配置 ----------
SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=qnct
MYSQL_USER=root
MYSQL_PASSWORD=qnct123456

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT（生产请换成 >=32 位随机串） ----------
JWT_SECRET=please-change-me-to-a-long-random-string

# ---------- 大模型 / 多模态视觉【此处需填入API Key】 ----------
# 申请：阿里云百炼 https://bailian.console.aliyun.com/（qwen-plus / qwen3-vl-plus）
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
VL_MODEL=qwen3-vl-plus

# ---------- 高德地图 Web 服务【此处需填入API Key】 ----------
# 申请：https://console.amap.com/
AMAP_WEB_KEY=

# ---------- 阿里云 OSS（可选）【此处需填入API Key】 ----------
# local=本机磁盘；oss=上传到阿里云 OSS
STORAGE_TYPE=local
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# ---------- 阿里云短信（可选）【此处需填入API Key】 ----------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=