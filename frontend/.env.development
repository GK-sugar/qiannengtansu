# 开发环境配置
VITE_APP_TITLE=黔能碳溯
VITE_API_BASE_URL=/api
# 演示模式：true 时前端使用内置 Mock 数据（无 API Key、无后端也可预览全站界面）
VITE_USE_MOCK=true
# 【此处需填入API Key】高德地图 JS API 2.0 Key：
# 填写后「物流追踪」页面渲染真实高德地图；留空则自动切换为 Canvas 自绘演示轨迹图。
VITE_AMAP_JS_KEY=fd64b3c70c3d9a17b6ac8accb8e9a1ae
# 高德 JS API 安全密钥（2021-12 后创建的 Key 必填，控制台→应用管理→我的应用）
# VITE_AMAP_SECURITY_CODE=